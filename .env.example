# LLM translation backend (recommended). Leave the key empty to use the
# built-in offline 文語->口語 converter instead.
AJT_PROVIDER=auto

# Any OpenAI-compatible endpoint: OpenAI, DeepSeek, Groq, LM Studio, llama.cpp, vLLM...
AJT_OPENAI_BASE_URL=https://api.openai.com/v1
AJT_OPENAI_API_KEY=
AJT_OPENAI_MODEL=gpt-4o-mini

# Google Gemini (used when AJT_PROVIDER=gemini)
AJT_GEMINI_API_KEY=
AJT_GEMINI_MODEL=gemini-2.0-flash

# Network
AJT_HOST=0.0.0.0
AJT_PORT=8765
# Shared secret for pairing the iPhone with the PC. Generated on first run if empty.
AJT_TOKEN=

# OCR
AJT_OCR_THREADS=8
AJT_OCR_MAX_SIDE=1280
AJT_MIN_SCORE=0.45
# Pull frames from an MJPEG URL instead of the browser camera (optional).
AJT_SOURCE_URL=
